<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" stylesheets="@../../../css/style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LogInController">
   <children>
      <VBox fx:id="startMenuContainer" alignment="CENTER" layoutX="216.0" layoutY="100.0" prefHeight="200.0" prefWidth="168.0" styleClass="startMenuContainer">
         <children>
            <Button fx:id="newGame" mnemonicParsing="false" onAction="#newGame" text="New Game" />
            <Button fx:id="score" mnemonicParsing="false" onAction="#getScore" text="Score" />
            <Button fx:id="exit" mnemonicParsing="false" onAction="#exit" text="Exit" />
         </children>
      </VBox>
      <AnchorPane fx:id="createPlayerMenuContainer" disable="true" prefHeight="400.0" prefWidth="600.0" styleClass="createPlayerMenuContainer" visible="false">
         <children>
            <TextField fx:id="playerName" layoutX="39.0" layoutY="57.0" styleClass="playerName" />
            <Label layoutX="39.0" layoutY="40.0" text="Name" />
            <Label layoutX="41.0" layoutY="123.0" text="Character" />
            <HBox alignment="CENTER" layoutX="41.0" layoutY="150.0" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <RadioButton contentDisplay="TOP" mnemonicParsing="false" onAction="#setChracter" styleClass="radioButton" text="Witch">
                     <graphic>
                        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <image>
                              <Image url="@../../../../java/resources/Town/2_1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <toggleGroup>
                        <ToggleGroup fx:id="characterGroup" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton contentDisplay="TOP" mnemonicParsing="false" onAction="#setChracter" styleClass="radioButton" text="Hunter" toggleGroup="$characterGroup">
                     <graphic>
                        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <image>
                              <Image url="@../../../../java/resources/Town/2_1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </RadioButton>
                  <RadioButton contentDisplay="TOP" mnemonicParsing="false" onAction="#setChracter" styleClass="radioButton" text="Researcher" toggleGroup="$characterGroup">
                     <graphic>
                        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                           <image>
                              <Image url="@../../../../java/resources/Town/2_1.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </RadioButton>
               </children>
            </HBox>
            <Button fx:id="start" layoutX="226.0" layoutY="317.0" mnemonicParsing="false" onAction="#start" text="Start" />
            <Button fx:id="back" layoutX="318.0" layoutY="317.0" mnemonicParsing="false" onAction="#back" text="Back" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
